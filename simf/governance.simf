// Issuer governance leaf. It deliberately permits any successor script while
// preserving the complete verifier-token quantity at output 0.

use std::lib::asserts::{assert_eq_32, assert_eq_64, assert_eq_256};
use std::lib::binary::not;

use crate::lib::assets::{explicit_input_asset_and_amount, explicit_output_asset_and_amount};

fn main() {
    assert_eq_32(jet::current_index(), 0);
    assert!(not(jet::eq_256(param::REGULATED_ASSET_ID, param::VERIFIER_ASSET_ID)));

    let (input_asset, input_amount): (u256, u64) = explicit_input_asset_and_amount(0);
    assert_eq_256(input_asset, param::VERIFIER_ASSET_ID);
    assert_eq_64(input_amount, param::VERIFIER_ASSET_AMOUNT);

    let (output_asset, output_amount): (u256, u64) = explicit_output_asset_and_amount(0);
    assert_eq_256(output_asset, param::VERIFIER_ASSET_ID);
    assert_eq_64(output_amount, param::VERIFIER_ASSET_AMOUNT);

    jet::bip_0340_verify(
        (param::ISSUER_PUBKEY, jet::sig_all_hash()),
        witness::ISSUER_SIGNATURE,
    );
}
