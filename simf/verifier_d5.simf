// Immutable depth-5 blacklist verifier.

use std::lib::asserts::{assert_eq_32, assert_eq_64, assert_eq_256};
use std::lib::binary::not;
use std::lib::u32::safe_add_32;
use crate::lib::assets::{explicit_input_asset, explicit_input_asset_and_amount, explicit_output_asset_and_amount};
use crate::lib::policy_d5::{NonMembershipProof, outpoint_key, verify_non_membership};
use crate::lib::taproot::state_script_hash;

type Recipients = [Option<Pubkey>; 10];
type ProofEntry = (u32, NonMembershipProof);
type ProofState = (u32, u32, Option<u32>, bool);

fn scan_input(regulated_input_count: u32, _context: (), index: u8) -> Either<u32, u32> {
    let index: u32 = jet::left_pad_low_8_32(index);
    match jet::input_asset(index) {
        None => Left(regulated_input_count),
        Some(asset: Asset1) => {
            let asset_id: u256 = unwrap_right::<(u1, u256)>(asset);
            match jet::eq_256(asset_id, param::REGULATED_ASSET_ID) {
                false => Right(regulated_input_count),
                true => Right(safe_add_32(regulated_input_count, 1)),
            }
        },
    }
}

fn verify_policy_proof(entry: Option<ProofEntry>, state: ProofState) -> ProofState {
    let (regulated_count, verified_count, previous_index, finished): ProofState = state;
    match entry {
        None => (regulated_count, verified_count, previous_index, true),
        Some(payload: ProofEntry) => {
            assert!(not(finished));
            let (input_index, proof): ProofEntry = payload;
            match previous_index { None => (), Some(previous: u32) => assert!(jet::lt_32(previous, input_index)), };
            assert_eq_256(explicit_input_asset(input_index), param::REGULATED_ASSET_ID);
            verify_non_membership(param::BLACKLIST_ROOT, param::BLACKLIST_COUNT, outpoint_key(unwrap(jet::input_prev_outpoint(input_index))), proof);
            (regulated_count, safe_add_32(verified_count, 1), Some(input_index), false)
        },
    }
}

fn validate_output(recipients: Recipients, _context: (), index: u8) -> Either<Recipients, Recipients> {
    let index: u32 = jet::left_pad_low_8_32(index);
    match jet::output_asset(index) {
        None => Left(recipients),
        Some(asset: Asset1) => {
            let asset_id: u256 = unwrap_right::<(u1, u256)>(asset);
            match jet::eq_256(asset_id, param::REGULATED_ASSET_ID) {
                false => Right(recipients),
                true => {
                    let [next, r2, r3, r4, r5, r6, r7, r8, r9, r10]: Recipients = recipients;
                    assert_eq_256(unwrap(jet::output_script_hash(index)), state_script_hash(param::USER_EXECUTABLE_LEAF_HASH, unwrap(next)));
                    Right([r2, r3, r4, r5, r6, r7, r8, r9, r10, None])
                },
            }
        },
    }
}

fn ensure_unused_recipient(recipient: Option<Pubkey>, _unused: ()) {
    match recipient { None => (), Some(_recipient: Pubkey) => panic!(), }
}

fn consume_budget(word: u256, valid: bool) -> bool {
    assert_eq_256(word, 0);
    valid
}

fn main() {
    assert!(array_fold::<consume_budget, 329>(witness::BUDGET_PADDING, true));
    assert_eq_32(jet::current_index(), 0);
    assert!(not(jet::eq_256(param::REGULATED_ASSET_ID, param::VERIFIER_ASSET_ID)));
    let (input_asset, input_amount): (u256, u64) = explicit_input_asset_and_amount(0);
    assert_eq_256(input_asset, param::VERIFIER_ASSET_ID);
    assert_eq_64(input_amount, param::VERIFIER_ASSET_AMOUNT);
    let (output_asset, output_amount): (u256, u64) = explicit_output_asset_and_amount(0);
    assert_eq_256(output_asset, param::VERIFIER_ASSET_ID);
    assert_eq_64(output_amount, param::VERIFIER_ASSET_AMOUNT);
    assert_eq_256(unwrap(jet::output_script_hash(0)), jet::current_script_hash());
    assert_eq_256(explicit_input_asset(1), param::REGULATED_ASSET_ID);
    assert_eq_256(unwrap(jet::input_script_hash(1)), state_script_hash(param::USER_EXECUTABLE_LEAF_HASH, witness::TRANSFER_OWNER));
    let input_scan: Either<u32, u32> = for_while::<scan_input>(0, ());
    let regulated_input_count: u32 = unwrap_left::<u32>(input_scan);
    let proof_state: ProofState = array_fold::<verify_policy_proof, 10>(witness::INPUT_POLICY_PROOFS, (regulated_input_count, 0, None, false));
    let (_inputs, verified_inputs, _last, _finished): ProofState = proof_state;
    assert_eq_32(verified_inputs, regulated_input_count);
    let output_scan: Either<Recipients, Recipients> = for_while::<validate_output>(witness::RECIPIENTS, ());
    array_fold::<ensure_unused_recipient, 10>(unwrap_left::<Recipients>(output_scan), ());
}
