// Asset IDs stay explicit. Governance requires explicit anchor values; holder
// and transfer checks also accept native commitments for the regulated asset.

pub fn explicit_input_asset(index: u32) -> u256 {
    let asset: Asset1 = unwrap(jet::input_asset(index));
    unwrap_right::<(u1, u256)>(asset)
}

pub fn explicit_input_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        unwrap_right::<(u1, u256)>(amount),
    )
}

pub fn explicit_output_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        unwrap_right::<(u1, u256)>(amount),
    )
}

// Audit transfers keep asset IDs explicit. A native value commitment contributes
// one record; an explicit value keeps its amount. The proof checks reject
// unaudited regulated outputs, while verifier-anchor values remain explicit.
pub fn input_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        match amount {
            Left(_c: Point) => {
                assert!(jet::eq_256(
                    unwrap_right::<Point>(asset),
                    param::REGULATED_ASSET_ID
                ));
                1
            },
            Right(v: u64) => v,
        },
    )
}

pub fn output_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        match amount {
            Left(_c: Point) => {
                assert!(jet::eq_256(
                    unwrap_right::<Point>(asset),
                    param::REGULATED_ASSET_ID
                ));
                1
            },
            Right(v: u64) => v,
        },
    )
}
