// Explicit-asset helpers. AMP keeps asset IDs visible so the verifier can
// identify every regulated output; confidential amounts remain possible.

pub fn explicit_current_asset() -> u256 {
    let asset: Asset1 = jet::current_asset();
    unwrap_right::<(u1, u256)>(asset)
}

pub fn explicit_input_asset(index: u32) -> u256 {
    let asset: Asset1 = unwrap(jet::input_asset(index));
    unwrap_right::<(u1, u256)>(asset)
}

pub fn explicit_input_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        unwrap_right::<(u1, u256)>(amount),
    )
}

pub fn explicit_output_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(index));
    (
        unwrap_right::<(u1, u256)>(asset),
        unwrap_right::<(u1, u256)>(amount),
    )
}
