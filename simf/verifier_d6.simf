// Native confidential transfer verifier. Witness access stays in main.
use crate::lib::audit::verify_records;
use crate::verifier::core::{
    InputSummary,
    ProofState,
    assert_all_inputs_verified,
    consume_budget,
    summarize_regulated_inputs,
    verify_anchor_and_initiator,
    verify_regulated_outputs,
};
use crate::verifier::d6::verify_policy_proof;

fn main() {
    assert!(array_fold::<consume_budget, 4096>(witness::BUDGET_PADDING, true));
    verify_anchor_and_initiator(witness::TRANSFER_OWNER);
    let (count, _regulated_input_amount): InputSummary = summarize_regulated_inputs();
    let state: ProofState = array_fold::<verify_policy_proof, 10>(
        witness::INPUT_POLICY_PROOFS,
        (count, 0, None, false),
    );
    assert_all_inputs_verified(count, state);
    let output_count: u64 = verify_regulated_outputs(witness::RECIPIENTS);
    verify_records(witness::AUDIT_RECORDS, output_count);
}
