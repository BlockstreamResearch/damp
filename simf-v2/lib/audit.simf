use std::lib::u32::{safe_add_32,safe_sub_32};

fn point_ge(p: Point) -> Ge {
    let (bit,x): Point = p;
    assert!(jet::eq_256(x,jet::fe_normalize(x)));
    unwrap(jet::decompress((bit,x)))
}
fn hash_point(ctx: Ctx8,p: Point)->Ctx8{
    let (bit,x):Point=p;
    let prefix:u8=match <u1>::into(bit) {false=>2,true=>3,};
    let ctx:Ctx8=jet::sha_256_ctx_8_add_1(ctx,prefix);
    jet::sha_256_ctx_8_add_32(ctx,x)
}
fn check(index:u32, parity:u1, root:u256,d:Point,tc:Point,td:Point,zv:u256,zb:u256,aux_hash:u256){
    let (asset,amount):(Asset1,Amount1)=unwrap(jet::output_amount(index));
    let asset:u256=unwrap_right::<Point>(asset);
    assert!(jet::eq_256(asset,param::REGULATED_ASSET_ID));
    let (qr,x):Point=unwrap_left::<u64>(amount);
    let c:Ge=point_ge((parity,x));
    let (_x,y):Ge=c;
    assert!(jet::eq_256(root,jet::fe_normalize(root)));
    let expected:u256=match <u1>::into(qr) {false=>y,true=>jet::fe_negate(y),};
    assert!(jet::eq_256(jet::fe_square(root),expected));
    let h:Ge=jet::hash_to_curve(asset);
    let p_point:Point=param::AUDIT_KEY;
    let p:Ge=point_ge(p_point);
    let dg:Ge=point_ge(d);let tcg:Ge=point_ge(tc);let tdg:Ge=point_ge(td);
    assert!(jet::eq_256(zv,jet::scalar_normalize(zv)));
    assert!(jet::eq_256(zb,jet::scalar_normalize(zb)));
    let ctx:Ctx8=jet::sha_256_ctx_8_init();
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,0x40bc08872d621dbf54869fa0c43912e034ade5ae6ef319f6a926912837c4421d);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,0x40bc08872d621dbf54869fa0c43912e034ade5ae6ef319f6a926912837c4421d);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,param::AUDIT_DEPLOYMENT);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_4(ctx,2);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_8(ctx,param::AUDIT_EPOCH);
    let ctx:Ctx8=hash_point(ctx,p_point);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,jet::sig_all_hash());
    let ctx:Ctx8=jet::sha_256_ctx_8_add_4(ctx,index);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,asset);
    let prefix:u8=match <u1>::into(qr) {false=>8,true=>9,};
    let ctx:Ctx8=jet::sha_256_ctx_8_add_1(ctx,prefix);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,x);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,unwrap(jet::output_script_hash(index)));
    let ctx:Ctx8=jet::sha_256_ctx_8_add_1(ctx,0);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,aux_hash);
    let ctx:Ctx8=hash_point(ctx,d);let ctx:Ctx8=hash_point(ctx,tc);let ctx:Ctx8=hash_point(ctx,td);
    let e:u256=jet::scalar_normalize(jet::sha_256_ctx_8_finalize(ctx));
    assert!(jet::gej_equiv(jet::linear_combination_1((zv,(h,1)),zb),jet::gej_ge_add(jet::scale(e,(c,1)),tcg)));
    assert!(jet::gej_equiv(jet::scale(zb,(p,1)),jet::gej_ge_add(jet::scale(e,(dg,1)),tdg)));
}

pub type Auxiliary=([u8;64],u256,u32,u16);
pub type RangeBody=([[u8;64];79],u32);
pub type AuditRecord=(u32,u1,u256,Point,Point,Point,u256,u256,Auxiliary,RangeBody);
pub type AuditRecords=[Option<AuditRecord>;10];
type AuditState=(u32,Option<u32>,bool,Ctx8);
fn add_aux(ctx:Ctx8,aux:Auxiliary)->Ctx8 {
    let(a,b,c,d):Auxiliary=aux;
    let ctx:Ctx8=jet::sha_256_ctx_8_add_64(ctx,a);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_32(ctx,b);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_4(ctx,c);
    jet::sha_256_ctx_8_add_2(ctx,d)
}
fn range_chunk(chunk:[u8;64],ctx:Ctx8)->Ctx8 {jet::sha_256_ctx_8_add_64(ctx,chunk)}
fn verify_range(index:u32,body:RangeBody) {
    // Exact consensus range header: exponent0,63bits,minimum1 => [1,2^63].
    // Full body is required: a header alone cannot authenticate to the introspected hash.
    let(chunks,tail):RangeBody=body;
    let ctx:Ctx8=jet::sha_256_ctx_8_init();
    let ctx:Ctx8=jet::sha_256_ctx_8_add_2(ctx,0x603e);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_8(ctx,1);
    let ctx:Ctx8=array_fold::<range_chunk,79>(chunks,ctx);
    let ctx:Ctx8=jet::sha_256_ctx_8_add_4(ctx,tail);
    assert!(jet::eq_256(jet::sha_256_ctx_8_finalize(ctx),unwrap(jet::output_range_proof(index))));
}

fn check_record(record:Option<AuditRecord>,state:AuditState)->AuditState {
    let(count,previous,finished,manifest):AuditState=state;
    match record {
        None=>(count,previous,true,manifest),
        Some(r:AuditRecord)=>{
            assert!(match finished {true=>false,false=>true,});
            let(index,parity,root,d,tc,td,zv,zb,aux,range):AuditRecord=r;
            verify_range(index,range);
            assert!(jet::lt_32(0,index));
            match previous {None=>(),Some(prev:u32)=>assert!(jet::lt_32(prev,index)),};
            let aux_hash:u256=jet::sha_256_ctx_8_finalize(add_aux(jet::sha_256_ctx_8_init(),aux));
            check(index,parity,root,d,tc,td,zv,zb,aux_hash);
            let manifest:Ctx8=jet::sha_256_ctx_8_add_4(manifest,index);
            let manifest:Ctx8=add_aux(manifest,aux);
            (safe_add_32(count,1),Some(index),false,manifest)
        },
    }
}
pub fn verify_records(records:AuditRecords,regulated_count:u64) {
    let(count,_previous,_finished,manifest):AuditState=array_fold::<check_record,10>(records,(0,None,false,jet::sha_256_ctx_8_init()));
    assert!(jet::lt_32(0,count));
    assert!(jet::eq_64(jet::left_pad_low_32_64(count),regulated_count));
    let manifest:Ctx8=jet::sha_256_ctx_8_add_4(manifest,count);
    let expected:u256=jet::sha_256_ctx_8_finalize(manifest);
    let script:Ctx8=jet::sha_256_ctx_8_add_2(jet::sha_256_ctx_8_init(),0x6a20);
    let script:Ctx8=jet::sha_256_ctx_8_add_32(script,expected);
    let index:u32=safe_sub_32(jet::num_outputs(),1);
    assert!(jet::eq_256(unwrap(jet::output_script_hash(index)),jet::sha_256_ctx_8_finalize(script)));
}
