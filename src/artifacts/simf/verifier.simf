        let (borrow_high, diff_high): (bool, u64) = jet::full_subtract_64(borrow_low, a_high, b_high);
        let res: u128 = <(u64, u64)>::into((diff_high, diff_low));
        (borrow_high, res)}
    pub fn checked_sub_128(a: u128, b: u128) -> Option<u128> {
