mod unit_10 {
    use crate::unit_3::{assert_eq_32, assert_eq_256};
    use crate::unit_5::safe_add_32;
    pub fn hash_key_leaf(key: u256) -> u256 {
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 0);
        jet::sha_256_ctx_8_finalize(jet::sha_256_ctx_8_add_32(ctx, key))}
    fn hash_node(left: u256, right: u256) -> u256 {
    let ctx: Ctx8 = jet::sha_256_ctx_8_init();
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_1(ctx, 2);
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, left);
        jet::sha_256_ctx_8_finalize(jet::sha_256_ctx_8_add_32(ctx, right))}
    pub fn merkle_step(sibling: u256, state: (u256, u32)) -> (u256, u32) {
    let (current, index): (u256, u32) = state;
        let parent: u256 = match jet::is_zero_32(jet::and_32(index, 1)){
    false => hash_node(sibling, current),
    true => hash_node(current, sibling),
    };
        (parent, jet::right_shift_32(1, index))}
    pub fn assert_leaf(root: u256, computed: u256, remaining: u32) {
    assert_eq_256(computed, root);
        assert_eq_32(remaining, 0);
    }
    fn lt_256(a: u256, b: u256) -> bool {
    let (a_high, a_low): (u128, u128) = <u256>::into(a);
        let (b_high, b_low): (u128, u128) = <u256>::into(b);
        let (a_0, a_1): (u64, u64) = <u128>::into(a_high);
        let (a_2, a_3): (u64, u64) = <u128>::into(a_low);
        let (b_0, b_1): (u64, u64) = <u128>::into(b_high);
        let (b_2, b_3): (u64, u64) = <u128>::into(b_low);
        match jet::eq_64(a_0, b_0){
    false => jet::lt_64(a_0, b_0),
    true => match jet::eq_64(a_1, b_1){
    false => jet::lt_64(a_1, b_1),
    true => match jet::eq_64(a_2, b_2){
    false => jet::lt_64(a_2, b_2),
    true => jet::lt_64(a_3, b_3),
    },
    },
    }}
    pub fn outpoint_key(outpoint: Outpoint) -> u256 {
    let (txid, vout): (u256, u32) = outpoint;
        let ctx: Ctx8 = jet::sha_256_ctx_8_init();
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, txid);
        jet::sha_256_ctx_8_finalize(jet::sha_256_ctx_8_add_4(ctx, vout))}
    pub fn assert_proof_header(count: u32, capacity: u32, insertion: u32) {
    assert!(jet::le_32(count, capacity));
        assert!(jet::le_32(insertion, count));
    }
    pub fn assert_lower(index: u32, neighbor: u256, key: u256, insertion: u32) {
    assert!(lt_256(neighbor, key));
        assert_eq_32(safe_add_32(index, 1), insertion);
    }
    pub fn assert_upper(index: u32, neighbor: u256, key: u256, insertion: u32) {
    assert_eq_32(index, insertion);
        assert!(lt_256(key, neighbor));
    }
    pub fn assert_empty_tree(root: u256, count: u32, empty_root: u256) {
    match jet::is_zero_32(count){
    false => (),
    true => assert_eq_256(root, empty_root),
    }}
}
mod unit_8 {
    use crate::unit_3::assert_eq_32;
    use crate::unit_10::{assert_empty_tree, assert_leaf, assert_lower, assert_proof_header, assert_upper, hash_key_leaf, merkle_step};
    pub use crate::unit_10::outpoint_key;
    pub type NeighborProof = (u32, u256, [u256; 4]);
    pub type NonMembershipProof = (u32, Option<NeighborProof>, Option<NeighborProof>);
    fn verify_leaf(root: u256, key: u256, index: u32, path: [u256; 4]) {
    let (computed, remaining): (u256, u32) = array_fold::<merkle_step, 4>(path, (hash_key_leaf(key), index));
        assert_leaf(root, computed, remaining);
    }
    pub fn verify_non_membership(root: u256, count: u32, key: u256, proof: NonMembershipProof) {
    let (insertion, lower, upper): NonMembershipProof = proof;
        assert_proof_header(count, 16, insertion);
        match lower{
    None => assert_eq_32(insertion, 0),
    Some(neighbor: NeighborProof) => {
    let (index, value, path): NeighborProof = neighbor;
        verify_leaf(root, value, index, path);
        assert_lower(index, value, key, insertion);
    }
    ,
    };
        match upper{
    None => assert_eq_32(insertion, count),
    Some(neighbor: NeighborProof) => {
    let (index, value, path): NeighborProof = neighbor;
        verify_leaf(root, value, index, path);
        assert_upper(index, value, key, insertion);
    }
    ,
    };
        assert_empty_tree(root, count, 0x36c614d3fcffdbdfe4baf66656fb17c8373bd42eb8aca046ec5b50ae8395f0cf);
    }
}
mod unit_2 {
    use crate::unit_3::assert_eq_256;
    use crate::unit_4::not;
    use crate::unit_5::safe_add_32;
    use crate::unit_6::explicit_input_asset;
    use crate::unit_8::{NonMembershipProof, outpoint_key, verify_non_membership};
    use crate::unit_1::ProofState;
    type ProofEntry = (u32, NonMembershipProof);
    pub fn verify_policy_proof(entry: Option<ProofEntry>, state: ProofState) -> ProofState {
    let (regulated_count, verified_count, previous_index, finished): ProofState = state;
        match entry{
    None => (regulated_count, verified_count, previous_index, true),
    Some(payload: ProofEntry) => {
    assert!(not(finished));
        let (input_index, proof): ProofEntry = payload;
        match previous_index{
    None => (),
    Some(previous: u32) => assert!(jet::lt_32(previous, input_index)),
    };
        assert_eq_256(explicit_input_asset(input_index), param::REGULATED_ASSET_ID);
        verify_non_membership(param::BLACKLIST_ROOT, param::BLACKLIST_COUNT, outpoint_key(unwrap(jet::input_prev_outpoint(input_index))), proof);
        (regulated_count, safe_add_32(verified_count, 1), Some(input_index), false)}
    ,
    }}
}
