mod unit_5 {
    pub fn not(bit: bool) -> bool {
    <u1>::into(jet::complement_1(<bool>::into(bit)))}
    pub fn or(a: bool, b: bool) -> bool {
    <u1>::into(jet::or_1(<bool>::into(a), <bool>::into(b)))}
    pub fn and(a: bool, b: bool) -> bool {
    <u1>::into(jet::and_1(<bool>::into(a), <bool>::into(b)))}
    pub fn xor(a: bool, b: bool) -> bool {
    and(or(a, b), not(and(a, b)))}
}
mod unit_4 {
    use crate::unit_5::{not, or, and};
    pub fn and_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::and_64(a_high, b_high), jet::and_64(a_low, b_low)))}
    pub fn or_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::or_64(a_high, b_high), jet::or_64(a_low, b_low)))}
    pub fn eq_128(a: u128, b: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        and(jet::eq_64(a_high, b_high), jet::eq_64(a_low, b_low))}
    pub fn left_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((jet::left_shift_64(shift, a_low), 0))}
    ,
    true => {
    let (_, low_to_high_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::right_shift_64(low_to_high_amount, a_low);
        let res_high: u64 = jet::or_64(jet::left_shift_64(shift, a_high), shifted_bits);
        <(u64, u64)>::into((res_high, jet::left_shift_64(shift, a_low)))}
    ,
    }}
    ,
    true => a,
    }}
    pub fn right_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((0, jet::right_shift_64(shift, a_high)))}
    ,
    true => {
    let (_, high_to_low_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::left_shift_64(high_to_low_amount, a_high);
        let res_low: u64 = jet::or_64(jet::right_shift_64(shift, a_low), shifted_bits);
        <(u64, u64)>::into((jet::right_shift_64(shift, a_high), res_low))}
    ,
    }}
    ,
    true => a,
    }}
    pub fn is_zero_128(a: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        and(jet::is_zero_64(a_high), jet::is_zero_64(a_low))}
    pub fn lt_128(a: u128, b: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        match jet::lt_64(a_high, b_high){
    false => {
    match jet::eq_64(a_high, b_high){
    false => false,
    true => jet::lt_64(a_low, b_low),
    }}
    ,
    true => true,
    }}
    pub fn le_128(a: u128, b: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        match jet::lt_64(a_high, b_high){
    false => {
    match jet::eq_64(a_high, b_high){
    false => false,
    true => jet::le_64(a_low, b_low),
    }}
    ,
    true => true,
    }}
    pub fn gt_128(a: u128, b: u128) -> bool {
    lt_128(b, a)}
    pub fn ge_128(a: u128, b: u128) -> bool {
    le_128(b, a)}
    pub fn add_128(a: u128, b: u128) -> (bool, u128) {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        let (carry_low, sum_low): (bool, u64) = jet::add_64(a_low, b_low);
        let (carry_high, sum_high): (bool, u64) = jet::full_add_64(carry_low, a_high, b_high);
        let res: u128 = <(u64, u64)>::into((sum_high, sum_low));
        (carry_high, res)}
    pub fn add_128_64(a: u128, b: u64) -> (bool, u128) {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (carry_low, res_low): (bool, u64) = jet::add_64(a_low, b);
        let (carry_high, res_high): (bool, u64) = jet::full_add_64(carry_low, a_high, 0);
        (carry_high, <(u64, u64)>::into((res_high, res_low)))}
    pub fn checked_add_128(a: u128, b: u128) -> Option<u128> {
    let (carry, sum): (bool, u128) = add_128(a, b);
        match carry{
    false => Some(sum),
    true => None,
    }}
    pub fn safe_add_128(a: u128, b: u128) -> u128 {
    unwrap(checked_add_128(a, b))}
    pub fn sub_128(a: u128, b: u128) -> (bool, u128) {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        let (borrow_low, diff_low): (bool, u64) = jet::subtract_64(a_low, b_low);
        let (borrow_high, diff_high): (bool, u64) = jet::full_subtract_64(borrow_low, a_high, b_high);
        let res: u128 = <(u64, u64)>::into((diff_high, diff_low));
        (borrow_high, res)}
    pub fn checked_sub_128(a: u128, b: u128) -> Option<u128> {
    let (borrow, diff): (bool, u128) = sub_128(a, b);
        match borrow{
    false => Some(diff),
    true => None,
    }}
    pub fn safe_sub_128(a: u128, b: u128) -> u128 {
    unwrap(checked_sub_128(a, b))}
    pub fn mul_128(a: u128, b: u128) -> u256 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        let highest: u128 = jet::multiply_64(a_high, b_high);
        let lowest: u128 = jet::multiply_64(a_low, b_low);
        let (word_1, word_0): (u64, u64) = <u128>::into(lowest);
        let (word_3, word_2): (u64, u64) = <u128>::into(highest);
        let product_1: u128 = jet::multiply_64(a_high, b_low);
        let product_2: u128 = jet::multiply_64(b_high, a_low);
        let (carry_3a, middle): (bool, u128) = add_128(product_1, product_2);
        let (middle_2, middle_1): (u64, u64) = <u128>::into(middle);
        let (carry_2, res_1): (bool, u64) = jet::add_64(word_1, middle_1);
        let (carry_3b, res_2): (bool, u64) = jet::full_add_64(carry_2, word_2, middle_2);
        let (_, res_3a): (bool, u64) = jet::full_add_64(carry_3a, word_3, 0);
        let (_, res_3): (bool, u64) = jet::full_add_64(carry_3b, res_3a, 0);
        let res_1_0: u128 = <(u64, u64)>::into((res_1, word_0));
        let res_3_2: u128 = <(u64, u64)>::into((res_3, res_2));
        <(u128, u128)>::into((res_3_2, res_1_0))}
    pub fn checked_mul_128(a: u128, b: u128) -> Option<u128> {
    let result: u256 = mul_128(a, b);
        let (high, low): (u128, u128) = <u256>::into(result);
        match is_zero_128(high){
    false => None,
    true => Some(low),
    }}
    pub fn safe_mul_128(a: u128, b: u128) -> u128 {
    unwrap(checked_mul_128(a, b))}
    pub fn split_256_into_64(a: u256) -> ((u64, u64), (u64, u64)) {
    let (high, low): (u128, u128) = <u256>::into(a);
        (<u128>::into(high), <u128>::into(low))}
    pub fn normalize_to_threshold(a: u128, b: u128, is_b_u128: bool) -> (u256, u128) {
    let threshold: u64 = 0x8000000000000000;
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        let b_highest_word: u64 = match is_b_u128{
    false => {
    assert!(jet::is_zero_64(b_high));
        b_low}
    ,
    true => b_high,
    };
        assert!(not(jet::is_zero_64(b_highest_word)));
        let (norm, remainder): (u64, u64) = jet::div_mod_64(threshold, b_highest_word);
        let norm: u64 = match jet::is_zero_64(remainder){
    false => {
    let (_, norm): (bool, u64) = jet::add_64(norm, 1);
        norm}
    ,
    true => norm,
    };
        let norm: u128 = <(u64, u64)>::into((0, norm));
        match jet::lt_64(b_highest_word, threshold){
    false => (<(u128, u128)>::into((0, a)), b),
    true => (mul_128(a, norm), safe_mul_128(b, norm)),
    }}
    pub fn algorithm_d(dividend: u128, divisor: u128) -> (u64, u128) {
    let (norm_dividend, norm_divisor): (u256, u128) = normalize_to_threshold(dividend, divisor, true);
        let ((_, u2), (u1, u0)): ((u64, u64), (u64, u64)) = split_256_into_64(norm_dividend);
        let (v1, v0): (u64, u64) = <u128>::into(norm_divisor);
        let (q_hat, r_hat): (u64, u64) = jet::div_mod_128_64(<(u64, u64)>::into((u2, u1)), v1);
        let r_hat_u0: u128 = <(u64, u64)>::into((r_hat, u0));
        let q: u64 = match lt_128(r_hat_u0, jet::multiply_64(q_hat, v0)){
    false => q_hat,
    true => {
    let (_, q_hat): (bool, u64) = jet::subtract_64(q_hat, 1);
        let (carry, r_hat): (bool, u64) = jet::add_64(r_hat, v1);
        match carry{
    false => {
    let r_hat_u0: u128 = <(u64, u64)>::into((r_hat, u0));
        match lt_128(r_hat_u0, jet::multiply_64(q_hat, v0)){
    false => q_hat,
    true => {
    let (_, q_hat): (bool, u64) = jet::subtract_64(q_hat, 1);
        q_hat}
    ,
    }}
    ,
    true => q_hat,
    }}
    ,
    };
        let remainder: u128 = safe_sub_128(dividend, safe_mul_128(divisor, <(u64, u64)>::into((0, q))));
        (q, remainder)}
    pub fn div_mod_128_64(a: u128, b: u64) -> (u128, u64) {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (q_high, remainder): (u64, u64) = jet::div_mod_64(a_high, b);
        let a_prime: u128 = <(u64, u64)>::into((remainder, a_low));
        let (a_normalized, b_normalized): (u256, u128) = normalize_to_threshold(a_prime, <(u64, u64)>::into((0, b)), false);
        let (_, a_normalized): (u128, u128) = <u256>::into(a_normalized);
        let (_, b_normalized): (u64, u64) = <u128>::into(b_normalized);
        let (q_low, _): (u64, u64) = jet::div_mod_128_64(a_normalized, b_normalized);
        let (_, remainder): (u64, u64) = <u128>::into(safe_sub_128(a_prime, jet::multiply_64(q_low, b)));
        (<(u64, u64)>::into((q_high, q_low)), remainder)}
    pub fn div_mod_128(a: u128, b: u128) -> (u128, u128) {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        match lt_128(a, b){
    false => {
    match and(jet::is_zero_64(a_high), jet::is_zero_64(b_high)){
    false => {
    match jet::eq_64(a_high, b_high){
    false => {
    match jet::is_zero_64(b_high){
    false => {
    let (q, r): (u64, u128) = algorithm_d(a, b);
        (<(u64, u64)>::into((0, q)), r)}
    ,
    true => {
    let (q, r): (u128, u64) = div_mod_128_64(a, b_low);
        (q, <(u64, u64)>::into((0, r)))}
    ,
    }}
    ,
    true => {
    let (_, diff): (bool, u64) = jet::subtract_64(a_low, b_low);
        (1, <(u64, u64)>::into((0, diff)))}
    ,
    }}
    ,
    true => {
    let (q, r): (u64, u64) = jet::div_mod_64(a_low, b_low);
        (<(u64, u64)>::into((0, q)), <(u64, u64)>::into((0, r)))}
    ,
    }}
    ,
    true => (0, a),
    }}
    pub fn div_128(a: u128, b: u128) -> u128 {
    let (q, _): (u128, u128) = div_mod_128(a, b);
        q}
    pub fn checked_div_128(a: u128, b: u128) -> Option<u128> {
    match is_zero_128(b){
    false => Some(div_128(a, b)),
    true => None,
    }}
    pub fn safe_div_128(a: u128, b: u128) -> u128 {
    unwrap(checked_div_128(a, b))}
}
mod unit_1 {
    use crate::unit_4::eq_128;
    pub fn assert_eq_1(a: u1, b: u1) {
    assert!(jet::eq_1(a, b))}
    pub fn assert_eq_8(a: u8, b: u8) {
    assert!(jet::eq_8(a, b));
    }
    pub fn assert_eq_16(a: u16, b: u16) {
    assert!(jet::eq_16(a, b));
    }
    pub fn assert_eq_32(a: u32, b: u32) {
    assert!(jet::eq_32(a, b));
    }
    pub fn assert_eq_64(a: u64, b: u64) {
    assert!(jet::eq_64(a, b));
    }
    pub fn assert_eq_128(a: u128, b: u128) {
    assert!(eq_128(a, b));
    }
    pub fn assert_eq_256(a: u256, b: u256) {
    assert!(jet::eq_256(a, b));
    }
    pub fn assert_none_1(val: Option<u1>) {
    assert!(is_none::<u1>(val));
    }
    pub fn assert_none_8(val: Option<u8>) {
    assert!(is_none::<u8>(val));
    }
    pub fn assert_none_16(val: Option<u16>) {
    assert!(is_none::<u16>(val));
    }
    pub fn assert_none_32(val: Option<u32>) {
    assert!(is_none::<u32>(val));
    }
    pub fn assert_none_64(val: Option<u64>) {
    assert!(is_none::<u64>(val));
    }
    pub fn assert_none_128(val: Option<u128>) {
    assert!(is_none::<u128>(val));
    }
    pub fn assert_none_256(val: Option<u256>) {
    assert!(is_none::<u256>(val));
    }
}
mod unit_2 {
    pub fn explicit_current_asset() -> u256 {
    let asset: Asset1 = jet::current_asset();
        unwrap_right::<(u1, u256)>(asset)}
    pub fn explicit_input_asset(index: u32) -> u256 {
    let asset: Asset1 = unwrap(jet::input_asset(index));
        unwrap_right::<(u1, u256)>(asset)}
    pub fn explicit_input_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(index));
        (unwrap_right::<(u1, u256)>(asset), unwrap_right::<(u1, u256)>(amount))}
    pub fn explicit_output_asset_and_amount(index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::output_amount(index));
        (unwrap_right::<(u1, u256)>(asset), unwrap_right::<(u1, u256)>(amount))}
}
mod unit_3 {
    pub fn tapdata_hash(state: u256) -> u256 {
    let ctx: Ctx8 = jet::tapdata_init();
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, state);
        jet::sha_256_ctx_8_finalize(ctx)}
    pub fn state_script_hash(executable_leaf_hash: u256, state: u256) -> u256 {
    let root: u256 = jet::build_tapbranch(executable_leaf_hash, tapdata_hash(state));
        let internal_key: Pubkey = 0x50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0;
        let output_key: u256 = jet::build_taptweak(internal_key, root);
        let ctx: Ctx8 = jet::sha_256_ctx_8_init();
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_2(ctx, 0x5120);
        let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, output_key);
        jet::sha_256_ctx_8_finalize(ctx)}
}
mod unit_0 {
    use crate::unit_1::{assert_eq_64, assert_eq_256};
    use crate::unit_2::{explicit_current_asset, explicit_input_asset_and_amount};
    use crate::unit_3::state_script_hash;
    fn main() {
    assert!(jet::lt_32(0, jet::current_index()));
        assert_eq_256(explicit_current_asset(), param::REGULATED_ASSET_ID);
        let (verifier_asset, verifier_amount): (u256, u64) = explicit_input_asset_and_amount(0);
        assert_eq_256(verifier_asset, param::VERIFIER_ASSET_ID);
        assert_eq_64(verifier_amount, param::VERIFIER_ASSET_AMOUNT);
        let owner: Pubkey = witness::OWNER_PUBKEY;
        let expected_script: u256 = state_script_hash(jet::tapleaf_hash(), owner);
        assert_eq_256(jet::current_script_hash(), expected_script);
        jet::bip_0340_verify((owner, jet::sig_all_hash()), witness::OWNER_SIGNATURE);
    }
}
